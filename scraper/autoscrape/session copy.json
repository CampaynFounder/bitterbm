{
  "domain": "https://superiorcourtclerk.cobbcounty.gov/WebCaseManagement",
  "description": "A workflow for searching and viewing civil case details in the Superior Court Clerk's web case management system.",
  "confidence": 0.9,
  "warnings": [],
  "steps": [
    {
      "id": "navigate_to_civil_search",
      "type": "navigate",
      "url": "https://superiorcourtclerk.cobbcounty.gov/WebCaseManagement"
    },
    {
      "id": "click_civil_search",
      "type": "click",
      "selector": "#hlCivilSearch"
    },
    {
      "id": "form_fill_search",
      "type": "form_fill",
      "fields": [
        {
          "selector": "#tbPersonSearch",
          "value": "lowther"
        }
      ],
      "submit": "#btnSearch"
    },
    {
      "id": "checkbox_selection",
      "type": "checkbox_group",
      "fields": [
        {
          "selector": "#cblCivilCourtTypes_1",
          "label": "Superior Civil",
          "value": true
        }
      ]
    },
    {
      "id": "click_search_button",
      "type": "click",
      "selector": "#btnSearch"
    },
    {
      "id": "table_results",
      "type": "row_crawler",
      "rowSelector": "tr:nth-of-type(10)",
      "capture": [
        {
          "field": "case_number",
          "selector": "td:nth-of-type(1)",
          "attr": "innerText"
        },
        {
          "field": "case_style",
          "selector": "td:nth-of-type(2)",
          "attr": "innerText"
        },
        {
          "field": "status",
          "selector": "td:nth-of-type(4)",
          "attr": "innerText"
        }
      ],
      "expand": {
        "trigger": "tr:nth-of-type(10) > td:nth-of-type(5)",
        "subTable": {
          "id": "sub_table_details",
          "capture": [
            {
              "field": "name",
              "selector": "div:nth-of-type(2) > table > tbody > tr:nth-of-type(2) > td:nth-of-type(1)",
              "attr": "innerText"
            },
            {
              "field": "represents",
              "selector": "div:nth-of-type(2) > table > tbody > tr:nth-of-type(2) > td:nth-of-type(2)",
              "attr": "innerText"
            }
          ]
        }
      }
    }
  ]
}
