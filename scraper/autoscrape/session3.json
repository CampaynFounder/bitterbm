{
  "domain": "superiorcourtclerk.cobbcounty.gov",
  "description": "Workflow for searching civil cases at Cobb County's Superior Court Clerk site using a person's name and specific court type filter.",
  "confidence": 0.9,
  "warnings": [],
  "steps": [
    {
      "id": "step1",
      "type": "navigate",
      "url": "https://superiorcourtclerk.cobbcounty.gov/WebCaseManagement/mainpage.aspx"
    },
    {
      "id": "step2",
      "type": "click",
      "selector": "#hlCivilSearch"
    },
    {
      "id": "step3",
      "type": "form_fill",
      "fields": [
        {
          "selector": "#tbPersonSearch",
          "value": "lowther"
        }
      ],
      "submit": "#btnSearch"
    },
    {
      "id": "step4",
      "type": "checkbox_group",
      "fields": [
        {
          "selector": "#cblCivilCourtTypes_1",
          "value": true
        }
      ]
    },
    {
      "id": "step5",
      "type": "row_crawler",
      "rowSelector": "tr",
      "capture": [
        {
          "field": "Case Type",
          "selector": "td:nth-of-type(5)"
        },
        {
          "field": "Document Type",
          "selector": "td:nth-of-type(10)"
        }
      ],
      "expand": {
        "trigger": "td:nth-of-type(4) > a",
        "subTable": {
          "rowSelector": "div:nth-of-type(2) > table > tbody > tr",
          "capture": [
            {
              "field": "Name",
              "selector": "td:nth-of-type(1)"
            }
          ]
        }
      }
    }
  ]
}
