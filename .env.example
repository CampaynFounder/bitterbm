# GA4 - set for conversion tracking
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase (auth + pipeline status)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chunk/embed script (scripts/chunk_embed.py) - use service_role key, not anon
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
OPENAI_API_KEY=sk-proj-...

# RAG ask (rag/ask.py) - LLM for answer generation
# RAG_LLM_PROVIDER=openai | anthropic  (default: anthropic)
# RAG_LLM_MODEL=gpt-4o | claude-sonnet-4-20250514  (optional; default per provider)
ANTHROPIC_API_KEY=sk-ant-...   # required if RAG_LLM_PROVIDER=anthropic

# Admin dashboard triggers (Modal web endpoints)
# modal deploy modal_courtlistener_test.py  → trigger URL
# modal deploy modal_rag.py                → chunk embed URL
# Create secret: modal secret create pipeline-trigger TRIGGER_SECRET=your-random-string
NEXT_PUBLIC_MODAL_TRIGGER_URL=https://xxx--courtlistener-test-trigger-fetch.modal.run
NEXT_PUBLIC_MODAL_CHUNK_EMBED_URL=https://xxx--bitterbm-rag-trigger-chunk-embed.modal.run
NEXT_PUBLIC_MODAL_SCRAPER_URL=https://xxx--bitterbm-scraper-trigger-run.modal.run
NEXT_PUBLIC_PIPELINE_TRIGGER_SECRET=your-random-string

# Background images - use your own URLs; omit to use Unsplash fallbacks
# NEXT_PUBLIC_HERO_BG=
# NEXT_PUBLIC_PROBLEM_BG=
# NEXT_PUBLIC_AI_BG=
# NEXT_PUBLIC_PRICING_BG=
# NEXT_PUBLIC_FINAL_CTA_BG=

# Optional: override image IDs for analytics (e.g. A/B test variants)
# NEXT_PUBLIC_HERO_BG_ID=hero_v2
# NEXT_PUBLIC_PROBLEM_BG_ID=problem_v2
